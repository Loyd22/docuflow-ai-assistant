
# Application settings
APP_NAME=DocuFlow AI
APP_ENV=development
APP_DEBUG=true

# Allowed frontend URLs (JSON array)
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local PostgreSQL settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=docuflow_db
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password

# Main application database
DATABASE_URL=postgresql+psycopg://your_database_user:your_database_password@localhost:5434/docuflow_db

# Test database (required only when running database tests)
TEST_DATABASE_URL=postgresql+psycopg://your_database_user:your_database_password@localhost:5434/docuflow_test

# Authentication
JWT_SECRET_KEY=replace-with-a-secure-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
